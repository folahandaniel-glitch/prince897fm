# Leave DATABASE_URL empty in development to use the embedded Postgres (PGlite) stored in .data/pg.
# In production set a managed Postgres URL (connect as the table owner; the app switches to role app_user per transaction).
DATABASE_URL=
# Secret used to HMAC audit hashes and CSRF-adjacent tokens. Generate: openssl rand -hex 32
APP_SECRET=
# Set to "true" to auto-create the demo tenants on an empty database (development only).
SEED_DEMO=true
# Secret for the daily attendance sweep (Vercel Cron sends it as a Bearer token). Generate: openssl rand -hex 32
CRON_SECRET=
# Organisation whose branding is shown on the public sign-in page of this deployment
DEFAULT_ORG_SLUG=prince897
# Public address of this deployment (used in emailed links such as password reset)
APP_URL=
# Optional email delivery (Resend). Without these, messages are queued and marked skipped.
RESEND_API_KEY=
MAIL_FROM=
# Optional SMS delivery (Termii)
TERMII_API_KEY=
TERMII_SENDER=
# Unlocks the one-time /setup page on a fresh deployment (16+ random characters)
SETUP_TOKEN=
